    },
    {
      "name": "4. Scan Kartu - Belum Terdaftar (404)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Device-Token", "value": "{{secret_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"UNKNOWN_CARD_999\",\n  \"device_id\": \"{{device_id}}\",\n  \"jenis\": \"RFID\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/iot/scan",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "iot", "scan"]
        }
      }
    },
    {
      "name": "5. Heartbeat Routine",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Device-Token", "value": "{{secret_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"wifi_rssi\": -65,\n  \"fw_version\": \"v2.0.0\",\n  \"scans_today\": 120\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/iot/heartbeat",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "iot", "heartbeat"]
        }
      }
    },
    {
      "name": "6. Device Config & Schedules",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Device-Token", "value": "{{secret_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"{{device_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/iot/config",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "iot", "config"]
        }
      }
    },
    {
      "name": "7. Firmware OTA Update Check",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Device-Token", "value": "{{secret_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/iot/firmware-check?current_version=v2.0.0",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "iot", "firmware-check"],
          "query": [
            { "key": "current_version", "value": "v2.0.0" }
          ]
        }
      }
    }
  ]
}
